generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String                  @unique
  subdomain              String?                 @unique
  nicLicense             String?
  plan                   TenantPlan              @default(BASIC)
  billingCycle           BillingCycle            @default(MONTHLY)
  tenantStatus           TenantStatus            @default(ACTIVE)
  isActive               Boolean                 @default(true)
  logoUrl                String?
  primaryColor           String?                 @default("#1E40AF")
  address                String?
  phone                  String?
  email                  String?
  adminEmail             String?
  storageUsedMb          Float                   @default(0)
  trialEndsAt            DateTime?
  customOnboardingNotes  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  nicLicenseExpiry       DateTime?
  approvals              Approval[]
  auditLogs              AuditLog[]
  branches               Branch[]
  calendarEvents         CalendarEvent[]
  carriers               Carrier[]
  chatMessages           ChatMessage[]
  chatRooms              ChatRoom[]
  claimFollowUps         ClaimFollowUp[]
  claimStatusHistories   ClaimStatusHistory[]
  claims                 Claim[]
  clients                Client[]
  commissions            Commission[]
  complaints             Complaint[]
  departments            Department[]
  documents              Document[]
  expenses               Expense[]
  integrations           Integration[]
  invitations            Invitation[]
  invoices               Invoice[]
  leads                  Lead[]
  notifications          Notification[]
  policies               Policy[]
  premiumFinancing       PremiumFinancing[]
  renewalTemplates       RenewalTemplate[]
  quotes                 Quote[]
  remittances            Remittance[]
  tasks                  Task[]
  transactions           Transaction[]
  users                  User[]
  roles                  Role[]
  importJobs             ImportJob[]
  columnMappingTemplates ColumnMappingTemplate[]
  ClaimDocument          ClaimDocument[]
  subscriptions          Subscription[]
  payments               PlatformPayment[]
  platformAuditLogs      PlatformAuditLog[]
  errorLogs              ErrorLog[]
  backgroundJobs         BackgroundJob[]
  emailLogs              EmailLog[]
  announcementReads      AnnouncementRead[]
  featureFlagOverrides   FeatureFlagOverride[]
  nicCompliance          NicCompliance?

  @@map("tenants")
}

model Branch {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  name        String
  code        String
  address     String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]
  users       User[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model User {
  id                      String                  @id @default(uuid()) @db.Uuid
  tenantId                String                  @db.Uuid
  email                   String
  passwordHash            String
  firstName               String
  lastName                String
  phone                   String?
  jobTitle                String?
  userRoleMappings        UserRoleMapping[]
  branchId                String?                 @db.Uuid
  departmentId            String?                 @db.Uuid
  avatarUrl               String?
  isActive                Boolean                 @default(true)
  lastLoginAt             DateTime?
  failedAttempts          Int                     @default(0)
  lockedUntil             DateTime?
  twoFactorEnabled        Boolean                 @default(false)
  twoFactorSecret         String?
  delegatedTo             String?                 @db.Uuid
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  deletedAt               DateTime?
  mustChangePassword      Boolean                 @default(false)
  processedApprovals      Approval[]              @relation("ApprovalProcessor")
  requestedApprovals      Approval[]              @relation("ApprovalRequester")
  auditLogs               AuditLog[]
  eventAttendances        CalendarAttendee[]
  createdEvents           CalendarEvent[]         @relation("EventCreator")
  sentMessages            ChatMessage[]           @relation("MessageSender")
  chatParticipations      ChatParticipant[]
  claimFollowUps          ClaimFollowUp[]         @relation("FollowUpBy")
  claimStatusHistories    ClaimStatusHistory[]    @relation("ClaimStatusHistoryCreator")
  assessedClaims          Claim[]                 @relation("ClaimAssessor")
  assignedClients         Client[]                @relation("AssignedBroker")
  commissions             Commission[]            @relation("CommissionBroker")
  assignedComplaints      Complaint[]             @relation("ComplaintAssignee")
  headOfDepartments       Department[]            @relation("DepartmentHead")
  uploadedDocuments       Document[]              @relation("DocumentUploader")
  uploadedClaimDocs       ClaimDocument[]         @relation("ClaimDocumentUploader")
  approvedExpenses        Expense[]               @relation("ExpenseApprover")
  sentInvitations         Invitation[]            @relation("InvitedBy")
  assignedLeads           Lead[]                  @relation("LeadBroker")
  notifications           Notification[]
  assignedPolicies        Policy[]                @relation("PolicyBroker")
  endorsementApprovals    PolicyEndorsement[]     @relation("EndorsementApprover")
  endorsementRequests     PolicyEndorsement[]     @relation("EndorsementRequester")
  preparedQuotes          Quote[]                 @relation("QuotePreparer")
  refreshTokens           RefreshToken[]
  processedRemittances    Remittance[]            @relation("RemittanceProcessor")
  assignedTasks           Task[]                  @relation("TaskAssignee")
  createdTasks            Task[]                  @relation("TaskCreator")
  processedTransactions   Transaction[]           @relation("TransactionProcessor")
  createdImportJobs       ImportJob[]             @relation("JobCreator")
  createdMappingTemplates ColumnMappingTemplate[] @relation("TemplateCreator")
  branch                  Branch?                 @relation(fields: [branchId], references: [id])
  department              Department?             @relation("DepartmentMember", fields: [departmentId], references: [id])
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Platform admin relations
  platformAuditLogs       PlatformAuditLog[]      @relation("PlatformAuditActor")
  createdIncidents        Incident[]              @relation("IncidentCreator")
  resolvedErrors          ErrorLog[]              @relation("ErrorResolver")
  createdAnnouncements    Announcement[]          @relation("AnnouncementCreator")
  updatedFeatureFlags     FeatureFlag[]           @relation("FlagUpdater")
  createdFlagOverrides    FeatureFlagOverride[]   @relation("FlagOverrideCreator")
  updatedSettings         PlatformSetting[]       @relation("SettingUpdater")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  email       String
  role        String           @default("AGENT")
  branchId    String?          @db.Uuid
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String           @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  tokenFamily String?
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id])
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([token])
  @@index([tokenFamily])
  @@index([email, tenantId])
  @@map("invitations")
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  replacedBy  String?   @db.Uuid
  ipAddress   String?
  userAgent   String?
  tokenFamily String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
  @@map("refresh_tokens")
}

model PasswordReset {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  tenantId    String    @db.Uuid
  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  tokenFamily String?

  @@index([token])
  @@index([tokenFamily])
  @@map("password_resets")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entity])
  @@map("audit_logs")
}

model Carrier {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  name          String
  shortName     String
  slug          String
  type          CarrierType
  licenseNumber String?
  status        String       @default("active")
  website       String?
  logoUrl       String?
  brandColor    String?
  phone         String?
  email         String?
  contactPerson String?
  address       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policies      Policy[]
  products      Product[]
  remittances   Remittance[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("carriers")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  carrierId      String        @db.Uuid
  name           String
  code           String
  insuranceType  InsuranceType
  description    String?
  commissionRate Decimal       @db.Decimal(5, 2)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  policies       Policy[]
  carrier        Carrier       @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("products")
}

model Client {
  id                     String             @id @default(uuid()) @db.Uuid
  tenantId               String             @db.Uuid
  clientNumber           String
  type                   ClientType
  status                 ClientStatus       @default(ACTIVE)
  firstName              String?
  lastName               String?
  companyName            String?
  phone                  String
  alternatePhone         String?
  email                  String?
  region                 String?
  city                   String?
  digitalAddress         String?
  postalAddress          String?
  ghanaCardNumber        String?
  dateOfBirth            DateTime?
  gender                 Gender?
  nationality            String?
  maritalStatus          String?
  occupation             String?
  employerName           String?
  employerAddress        String?
  sourceOfFunds          String?
  purposeOfRelationship  String?
  expectedVolume         String?
  preferredCommunication String?
  kycStatus              KycStatus          @default(PENDING)
  amlRiskLevel           AmlRiskLevel       @default(LOW)
  isPep                  Boolean            @default(false)
  eddRequired            Boolean            @default(false)
  assignedBrokerId       String?            @db.Uuid
  dateOfIncorporation    DateTime?
  industry               String?
  contactPerson          String?
  contactPersonPhone     String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?
  registrationNumber     String?
  tin                    String?
  bankDetails            BankDetail[]
  beneficiaries          Beneficiary[]
  claims                 Claim[]
  assignedBroker         User?              @relation("AssignedBroker", fields: [assignedBrokerId], references: [id])
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  commissions            Commission[]
  invoices               Invoice[]
  leads                  Lead[]             @relation("ConvertedClient")
  nextOfKin              NextOfKin[]
  policies               Policy[]
  premiumFinancing       PremiumFinancing[]
  quotes                 Quote[]
  transactions           Transaction[]

  @@unique([tenantId, clientNumber])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@map("clients")
}

model Beneficiary {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  clientId        String    @db.Uuid
  fullName        String
  relationship    String
  dateOfBirth     DateTime?
  ghanaCardNumber String?
  phone           String?
  percentage      Decimal   @db.Decimal(5, 2)
  guardianName    String?
  createdAt       DateTime  @default(now())
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("beneficiaries")
}

model NextOfKin {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  clientId     String  @db.Uuid
  fullName     String
  relationship String
  phone        String
  address      String?
  client       Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("next_of_kin")
}

model BankDetail {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @db.Uuid
  clientId      String @db.Uuid
  bankName      String
  accountName   String
  accountNumber String
  branch        String
  client        Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("bank_details")
}

enum RenewalStatus {
  NOT_STARTED
  CONTACTED
  QUOTE_SENT
  NEGOTIATING
  CONFIRMED
  RENEWED
  DECLINED
}

enum LapseReason {
  NON_PAYMENT
  CLIENT_DECLINED
  UNREACHABLE
  SWITCHED_INSURER
  COVERAGE_NO_LONGER_NEEDED
}

model Policy {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @db.Uuid
  policyNumber       String
  status             PolicyStatus         @default(DRAFT)
  insuranceType      InsuranceType
  policyType         PolicyType
  coverageType       String?
  nicClassOfBusiness String?
  clientId           String               @db.Uuid
  carrierId          String               @db.Uuid
  productId          String?              @db.Uuid
  brokerId           String               @db.Uuid
  inceptionDate      DateTime
  expiryDate         DateTime
  issueDate          DateTime?
  claimCount         Int                  @default(0)
  totalClaimsValue   Decimal              @default(0) @db.Decimal(15, 2)
  sumInsured         Decimal?             @db.Decimal(15, 2)
  premiumAmount      Decimal              @db.Decimal(15, 2)
  commissionRate     Decimal              @db.Decimal(5, 2)
  commissionAmount   Decimal              @db.Decimal(15, 2)
  commissionStatus   CommissionStatus     @default(PENDING)
  currency           String               @default("GHS")
  premiumFrequency   PremiumFrequency     @default(ANNUAL)
  paymentStatus      PaymentStatus        @default(PENDING)
  coverageDetails    String?
  isRenewal          Boolean              @default(false)
  previousPolicyId   String?              @db.Uuid
  renewalStatus      RenewalStatus        @default(NOT_STARTED)
  lapseReason        LapseReason?
  cancellationReason CancellationReason?
  cancellationDate   DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  claims             Claim[]
  commissions        Commission[]
  invoices           Invoice[]
  marineDetails      MarineDetail?
  broker             User                 @relation("PolicyBroker", fields: [brokerId], references: [id])
  carrier            Carrier              @relation(fields: [carrierId], references: [id])
  client             Client               @relation(fields: [clientId], references: [id])
  product            Product?             @relation(fields: [productId], references: [id])
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policyDocuments    PolicyDocument[]
  endorsements       PolicyEndorsement[]
  premiumFinancing   PremiumFinancing[]
  installments       PremiumInstallment[]
  propertyDetails    PropertyDetail?
  sourceQuotes       Quote[]              @relation("QuoteToPolicy")
  remittances        Remittance[]
  transactions       Transaction[]
  vehicleDetails     VehicleDetail?
  renewalLogs        RenewalLog[]

  @@unique([tenantId, policyNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, insuranceType])
  @@index([tenantId, clientId])
  @@index([tenantId, expiryDate])
  @@map("policies")
}

model VehicleDetail {
  id                 String          @id @default(uuid()) @db.Uuid
  policyId           String          @unique @db.Uuid
  registrationNumber String?
  chassisNumber      String?
  engineNumber       String?
  make               String?
  model              String?
  year               Int?
  bodyType           String?
  color              String?
  engineCapacity     String?
  seatingCapacity    Int?
  usageType          String?
  estimatedValue     Decimal?        @db.Decimal(15, 2)
  motorCoverType     MotorCoverType?
  policy             Policy          @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@map("vehicle_details")
}

model PropertyDetail {
  id               String   @id @default(uuid()) @db.Uuid
  policyId         String   @unique @db.Uuid
  propertyAddress  String?
  propertyType     String?
  constructionType String?
  yearBuilt        Int?
  estimatedValue   Decimal? @db.Decimal(15, 2)
  occupancyType    String?
  policy           Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@map("property_details")
}

model MarineDetail {
  id               String   @id @default(uuid()) @db.Uuid
  policyId         String   @unique @db.Uuid
  vesselName       String?
  imoNumber        String?
  voyageRoute      String?
  cargoDescription String?
  cargoValue       Decimal? @db.Decimal(15, 2)
  conveyanceType   String?
  policy           Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@map("marine_details")
}

model PolicyEndorsement {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  policyId          String            @db.Uuid
  type              EndorsementType
  status            EndorsementStatus @default(PENDING)
  description       String?
  effectiveDate     DateTime?
  premiumAdjustment Decimal?          @db.Decimal(15, 2)
  requestedById     String            @db.Uuid
  approvedById      String?           @db.Uuid
  createdAt         DateTime          @default(now())
  approvedBy        User?             @relation("EndorsementApprover", fields: [approvedById], references: [id])
  policy            Policy            @relation(fields: [policyId], references: [id], onDelete: Cascade)
  requestedBy       User              @relation("EndorsementRequester", fields: [requestedById], references: [id])

  @@index([tenantId])
  @@index([policyId])
  @@map("policy_endorsements")
}

model PremiumInstallment {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  policyId          String            @db.Uuid
  installmentNumber Int
  dueDate           DateTime
  amount            Decimal           @db.Decimal(15, 2)
  status            InstallmentStatus @default(PENDING)
  paidDate          DateTime?
  policy            Policy            @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([policyId])
  @@map("premium_installments")
}

model PolicyDocument {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  policyId   String   @db.Uuid
  name       String
  type       String
  url        String?
  uploadedAt DateTime @default(now())
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([policyId])
  @@map("policy_documents")
}

model Claim {
  id                     String               @id @default(uuid()) @db.Uuid
  tenantId               String               @db.Uuid
  claimNumber            String
  status                 ClaimStatus          @default(INTIMATED)
  policyId               String               @db.Uuid
  insuranceType          InsuranceType
  clientId               String               @db.Uuid
  incidentDate           DateTime
  incidentDescription    String
  incidentLocation       String?
  perilType              String?
  claimAmount            Decimal              @db.Decimal(15, 2)
  currency               String               @default("GHS")
  insurerReference       String?
  insurerSubmissionDate  DateTime?
  intimationDate         DateTime             @default(now())
  registrationDate       DateTime?
  acknowledgmentDeadline DateTime
  processingDeadline     DateTime
  assessedAmount         Decimal?             @db.Decimal(15, 2)
  settledAmount          Decimal?             @db.Decimal(15, 2)
  deductibleAmount       Decimal?             @db.Decimal(15, 2)
  settlementDate         DateTime?
  rejectionReason        String?
  appealNotes            String?
  nicEscalationDate      DateTime?
  nicEscalationRef       String?
  isOverdue              Boolean              @default(false)
  assessorId             String?              @db.Uuid
  policeReportNumber     String?
  closedDate             DateTime?
  siteVisitDate          DateTime?
  damageDescription      String?
  repairEstimate         Decimal?             @db.Decimal(15, 2)
  recommendedSettlement  Decimal?             @db.Decimal(15, 2)
  assessorNotes          String?
  paymentMethod          PaymentMethod?
  paymentReference       String?
  paymentDate            DateTime?
  thirdPartyName         String?
  thirdPartyPhone        String?
  thirdPartyVehicleReg   String?
  thirdPartyInsurer      String?
  thirdPartyClaimRef     String?
  faultAssessment        String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?
  claimDocuments         ClaimDocument[]
  followUps              ClaimFollowUp[]
  statusHistories        ClaimStatusHistory[]
  assessor               User?                @relation("ClaimAssessor", fields: [assessorId], references: [id])
  client                 Client               @relation(fields: [clientId], references: [id])
  policy                 Policy               @relation(fields: [policyId], references: [id])
  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, claimNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, policyId])
  @@map("claims")
}

model ClaimStatusHistory {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  claimId    String      @db.Uuid
  fromStatus ClaimStatus
  toStatus   ClaimStatus
  changedBy  String      @db.Uuid
  notes      String?
  createdAt  DateTime    @default(now())
  claim      Claim       @relation(fields: [claimId], references: [id])
  user       User        @relation("ClaimStatusHistoryCreator", fields: [changedBy], references: [id])
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([tenantId, createdAt])
  @@map("claim_status_history")
}

model ClaimDocument {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @db.Uuid
  claimId    String            @db.Uuid
  name       String
  type       ClaimDocumentType
  url        String?
  uploadedAt DateTime          @default(now())
  claim      Claim             @relation(fields: [claimId], references: [id], onDelete: Cascade)
  uploadedBy String            @db.Uuid
  uploader   User              @relation("ClaimDocumentUploader", fields: [uploadedBy], references: [id])
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([claimId])
  @@map("claim_documents")
}

model Complaint {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  complaintNumber   String
  status            ComplaintStatus   @default(REGISTERED)
  priority          ComplaintPriority @default(MEDIUM)
  complainantName   String
  complainantPhone  String?
  complainantEmail  String?
  subject           String
  category          String?
  description       String
  escalationLevel   Int               @default(0)
  assignedToId      String?           @db.Uuid
  slaDeadline       DateTime
  isBreached        Boolean           @default(false)
  resolutionDetails String?
  resolvedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  assignedTo        User?             @relation("ComplaintAssignee", fields: [assignedToId], references: [id])
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, complaintNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("complaints")
}

model Lead {
  id                  String       @id @default(uuid()) @db.Uuid
  tenantId            String       @db.Uuid
  leadNumber          String
  status              LeadStatus   @default(NEW)
  priority            LeadPriority @default(WARM)
  source              LeadSource   @default(OTHER)
  contactName         String
  companyName         String?
  phone               String?
  email               String?
  productInterest     String[]
  estimatedPremium    Decimal?     @db.Decimal(15, 2)
  estimatedCommission Decimal?     @db.Decimal(15, 2)
  assignedBrokerId    String?      @db.Uuid
  score               Int          @default(0)
  nextFollowUpDate    DateTime?
  lastContactDate     DateTime?
  notes               String?
  convertedClientId   String?      @db.Uuid
  convertedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?
  assignedBroker      User?        @relation("LeadBroker", fields: [assignedBrokerId], references: [id])
  convertedClient     Client?      @relation("ConvertedClient", fields: [convertedClientId], references: [id])
  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, leadNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("leads")
}

model Document {
