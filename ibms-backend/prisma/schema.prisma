  HOT
  WARM
  COLD
}

enum TaskStatus {
  PENDING
  UNDER_REVIEW
  REGISTERED
}

enum CalendarEventType {
  POLICY
  MEETING
  CLAIM
  TEAM
  COMPLIANCE
  PAYMENT
}

enum CalendarEventStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum ClaimDocumentType {
  POLICE_REPORT
  MEDICAL_REPORT
  REPAIR_ESTIMATE
  ADJUSTER_REPORT
  SETTLEMENT_LETTER
  CORRESPONDENCE
  PHOTOGRAPH
  OTHER
}

// ═══════════════════════════════════════════════════════════════
// SUPER ADMIN PLATFORM MODELS
// ═══════════════════════════════════════════════════════════════

// ─── ENUMS ───────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
  TRIAL
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  OVERDUE
  CANCELLED
  TRIAL
}

enum PlatformPaymentStatus {
  PAID
  FAILED
  REFUNDED
  PENDING
}

enum AuditCategory {
  AUTH
  TENANT
  USER
  BILLING
  POLICY
  CLAIM
  COMPLIANCE
  SYSTEM
  ERROR
  SECURITY
}

enum AuditSeverity {
  INFO
  WARN
  CRITICAL
}

enum AuditStatus {
  SUCCESS
  FAILED
}

enum ServiceHealthStatus {
  HEALTHY
  DEGRADED
  DOWN
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

enum ErrorSeverity {
  FATAL
  ERROR
  WARNING
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
}

enum EmailDeliveryStatus {
  SENT
  DELIVERED
  BOUNCED
  FAILED
  SPAM
}

enum AnnouncementType {
  INFO
  WARNING
  CRITICAL
  MAINTENANCE
}

enum AnnouncementTarget {
  ALL
  BY_PLAN
  SPECIFIC
}

enum AnnouncementDelivery {
  IN_APP
  EMAIL
  BOTH
}

// ─── SUBSCRIPTION & BILLING ─────────────────────────────────

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  tenantId               String             @db.Uuid
  plan                   TenantPlan
  billingCycle           BillingCycle
  amountGhs              Decimal            @db.Decimal(12, 2)
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  paystackSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments               PlatformPayment[]

  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

model PlatformPayment {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @db.Uuid
  subscriptionId    String                @db.Uuid
  amountGhs         Decimal               @db.Decimal(12, 2)
  status            PlatformPaymentStatus @default(PENDING)
  paystackReference String?
  invoiceNumber     String?
  paidAt            DateTime?
  createdAt         DateTime              @default(now())
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription      Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@map("platform_payments")
}

// ─── PLATFORM AUDIT LOG (IMMUTABLE) ─────────────────────────

model PlatformAuditLog {
  id               String        @id @default(uuid()) @db.Uuid
  actorId          String        @db.Uuid
  actorEmail       String
  actorRole        String
  tenantId         String?       @db.Uuid
  tenantName       String?
  sessionId        String?
  impersonatedById String?       @db.Uuid
  category         AuditCategory
  severity         AuditSeverity @default(INFO)
  action           String
  resourceType     String?
  resourceId       String?
  description      String
  beforeState      Json?
  afterState       Json?
  metadata         Json?
  ipAddress        String?
  userAgent        String?
  requestId        String?
  status           AuditStatus   @default(SUCCESS)
  createdAt        DateTime      @default(now())
  actor            User          @relation("PlatformAuditActor", fields: [actorId], references: [id])
  tenant           Tenant?       @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([actorId])
  @@index([category])
  @@index([severity])
  @@index([createdAt])
  @@index([status])
  @@map("platform_audit_logs")
}

// ─── SYSTEM HEALTH & INCIDENTS ──────────────────────────────

model SystemHealthCheck {
  id             String              @id @default(uuid()) @db.Uuid
  serviceName    String
  status         ServiceHealthStatus
  responseTimeMs Int
  checkedAt      DateTime            @default(now())
  errorMessage   String?

  @@index([serviceName])
  @@index([checkedAt])
  @@map("system_health_checks")
}

model Incident {
  id               String         @id @default(uuid()) @db.Uuid
  title            String
  status           IncidentStatus @default(OPEN)
  severity         AuditSeverity
  affectedServices Json
  startedAt        DateTime       @default(now())
  resolvedAt       DateTime?
  rootCause        String?
  resolutionNotes  String?
  createdById      String         @db.Uuid
  createdAt        DateTime       @default(now())
  createdBy        User           @relation("IncidentCreator", fields: [createdById], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("incidents")
}

// ─── ERROR TRACKING ─────────────────────────────────────────

model ErrorLog {
  id              String        @id @default(uuid()) @db.Uuid
  errorType       String
  message         String
  stackTrace      String
  severity        ErrorSeverity @default(ERROR)
  tenantId        String?       @db.Uuid
  userId          String?       @db.Uuid
  requestMethod   String?
  requestUrl      String?
  requestBody     Json?
  statusCode      Int?
  resolved        Boolean       @default(false)
  resolvedAt      DateTime?
  resolvedById    String?       @db.Uuid
  notes           String?
  occurrenceCount Int           @default(1)
  firstSeenAt     DateTime      @default(now())
  lastSeenAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  tenant          Tenant?       @relation(fields: [tenantId], references: [id])
  resolvedBy      User?         @relation("ErrorResolver", fields: [resolvedById], references: [id])

  @@index([tenantId])
  @@index([severity])
  @@index([resolved])
  @@index([lastSeenAt])
  @@map("error_logs")
}

// ─── BACKGROUND JOBS ────────────────────────────────────────

model BackgroundJob {
  id           String    @id @default(uuid()) @db.Uuid
  jobName      String
  tenantId     String?   @db.Uuid
  status       JobStatus @default(QUEUED)
  priority     Int       @default(0)
  payload      Json?
  result       Json?
  errorMessage String?
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  enqueuedAt   DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  nextRetryAt  DateTime?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([status])
  @@index([tenantId])
  @@index([jobName])
  @@index([enqueuedAt])
  @@map("background_jobs")
}

// ─── EMAIL LOGS ─────────────────────────────────────────────

model EmailLog {
  id                String              @id @default(uuid()) @db.Uuid
  templateName      String
  recipientEmail    String
  tenantId          String?             @db.Uuid
  subject           String
  status            EmailDeliveryStatus @default(SENT)
  providerMessageId String?
  providerResponse  Json?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime            @default(now())
  tenant            Tenant?             @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([recipientEmail])
  @@index([createdAt])
  @@map("email_logs")
}

// ─── ANNOUNCEMENTS ──────────────────────────────────────────

model Announcement {
  id          String               @id @default(uuid()) @db.Uuid
  title       String
  body        String
  type        AnnouncementType     @default(INFO)
  targetType  AnnouncementTarget   @default(ALL)
  targetIds   Json?
  delivery    AnnouncementDelivery @default(IN_APP)
  isPinned    Boolean              @default(false)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdById String               @db.Uuid
  createdAt   DateTime             @default(now())
  createdBy   User                 @relation("AnnouncementCreator", fields: [createdById], references: [id])
  reads       AnnouncementRead[]

  @@index([createdAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String       @id @default(uuid()) @db.Uuid
  announcementId String       @db.Uuid
  tenantId       String       @db.Uuid
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([announcementId, tenantId])
  @@map("announcement_reads")
}

// ─── FEATURE FLAGS ──────────────────────────────────────────

model FeatureFlag {
  id                String                @id @default(uuid()) @db.Uuid
  key               String                @unique
  label             String
  description       String?
  globalEnabled     Boolean               @default(false)
  starterEnabled    Boolean               @default(false)
  proEnabled        Boolean               @default(false)
  enterpriseEnabled Boolean               @default(false)
  updatedById       String?               @db.Uuid
  updatedAt         DateTime              @updatedAt
  updatedBy         User?                 @relation("FlagUpdater", fields: [updatedById], references: [id])
  overrides         FeatureFlagOverride[]

  @@map("feature_flags")
}

model FeatureFlagOverride {
  id          String      @id @default(uuid()) @db.Uuid
  flagId      String      @db.Uuid
  tenantId    String      @db.Uuid
  enabled     Boolean
  createdById String      @db.Uuid
  createdAt   DateTime    @default(now())
  flag        FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("FlagOverrideCreator", fields: [createdById], references: [id])

  @@unique([flagId, tenantId])
  @@map("feature_flag_overrides")
}

// ─── PLATFORM SETTINGS (KEY-VALUE) ──────────────────────────

model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("SettingUpdater", fields: [updatedById], references: [id])

  @@map("platform_settings")
}

// ─── NIC COMPLIANCE ─────────────────────────────────────────

model NicCompliance {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @unique @db.Uuid
  licenceNumber        String?
  expiryDate           DateTime?
  segregationCompliant Boolean   @default(false)
  lastRemittanceDate   DateTime?
  nextRemittanceDue    DateTime?
  levyStatus           String?
  kycStatus            String?
  complianceScore      Int       @default(0)
  lastCheckedAt        DateTime?
  updatedAt            DateTime  @updatedAt
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("nic_compliance")
}

// ─── IMPORT SYSTEM ──────────────────────────────────────────

enum ImportStatus {
  PENDING
  MAPPING
  VALIDATING
  READY
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  PENDING
  READY
  WARNING
  ERROR
  DUPLICATE
  IMPORTED
  SKIPPED
}

model ImportJob {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @db.Uuid
  createdById       String       @db.Uuid
  dataType          String // 'clients', 'policies', etc.
  fileName          String
  fileSize          Int
  status            ImportStatus @default(PENDING)
  totalRows         Int          @default(0)
  processedRows     Int          @default(0)
  importedRows      Int          @default(0)
  skippedRows       Int          @default(0)
  errorRows         Int          @default(0)
  warningRows       Int          @default(0)
  duplicateRows     Int          @default(0)
  rawFileData       Json? // Parsed file contents (temporary)
  detectedMappings  Json? // AI/rule-based detected mappings
  confirmedMappings Json? // User-confirmed mappings
  validationResult  Json? // Full validation result
  mappingMethod     String? // 'AI_HYBRID' | 'RULES' | 'AI'
  mapping           Json? // Legacy mapping field
  resultReportUrl   String?
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User           @relation("JobCreator", fields: [createdById], references: [id])
  rows      ImportJobRow[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([status])
  @@map("import_jobs")
}

model ImportJobRow {
  id              String          @id @default(uuid()) @db.Uuid
  jobId           String          @db.Uuid
  tenantId        String          @db.Uuid
  rowIndex        Int
  rawData         Json
  mappedData      Json?
  transformedData Json? // After transformations
  status          ImportRowStatus @default(PENDING)
  clientId        String?         @db.Uuid // Set if successfully imported
  errors          Json? // Array of ValidationIssue[]
  warnings        Json? // Array of ValidationIssue[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([jobId, status])
  @@map("import_job_rows")
}

model ColumnMappingTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  createdById String   @db.Uuid
  name        String
  dataType    String // 'clients', 'policies'
  mapping     Json // The actual map: { sourceCol: systemField }
  timesUsed   Int      @default(0)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("TemplateCreator", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([tenantId, dataType])
  @@map("column_mapping_templates")
}

model RenewalTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  subject     String
  htmlContent String   @db.Text
  triggerDays Int // e.g., 90, 60, 30
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("renewal_templates")
}

model RenewalLog {
  id        String   @id @default(uuid()) @db.Uuid
  policyId  String   @db.Uuid
  tenantId  String   @db.Uuid
  logType   String // 'EMAIL_SENT', 'STATUS_CHANGE', 'NOTE_ADDED'
  title     String
  details   String?  @db.Text
  createdAt DateTime @default(now())
  createdBy String?  @db.Uuid // null if system CRON

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([tenantId])
  @@map("renewal_logs")
}
